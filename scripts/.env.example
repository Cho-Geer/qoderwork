# Copy to scripts/.env for local use.
# Keep real secrets only in scripts/.env, never commit them.

# Runtime API keys (examples only)
DEEPSEEK_API_KEY=your_deepseek_api_key
VOLCENGINE_PLAN_API_KEY=your_volcengine_plan_api_key

# Git remote template
GIT_REMOTE_NAME=origin
GIT_REMOTE_PROTOCOL=ssh
GIT_REMOTE_HOST=github.com
GIT_REMOTE_OWNER=your-github-username
GIT_REMOTE_REPO=qoderwork
GIT_REMOTE_BRANCH=main

# Optional full remote URL override
# GIT_REMOTE_URL=git@github.com:your-github-username/qoderwork.git
