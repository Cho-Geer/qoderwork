producer_release_registry:
  schema_version: audit-producer-release-registry/v1
  producer_version: audit-governance-release/1
  manifest_schema:
    schema_version: audit-producer-release/v1
    document_kind: producer-release-manifest
    governance_profile: audit-governance-recovery/v1
    exact_top_level_keys:
      - schema_version
      - document_kind
      - governance_profile
      - release_id
      - case_set
      - canonical_contract
      - registry_projection
      - registry_projection_sha256
      - normalized_source_set_sha256
      - source_base_commit
      - producer_version
      - tool_sources
      - transitive_dependencies
      - created_at
    exact_entry_keys: [historical_path, classification, source_base_commit, version, bytes]
    release_id_rule: SHA256 of UTF-8 compact JSON [canonical_contract, registry_projection_sha256, normalized_source_set_sha256, source_base_commit, producer_version]
    registry_projection_rule: >
      Exact compact JSON object with keys case_set, inheritance_chain, explicit_paths,
      recursive_roots, governance_profile, producer_version. Arrays are normalized,
      duplicate-free, and UTF-8-code-point sorted. registry_projection_sha256 hashes those
      compact bytes.
    normalized_source_set_rule: >
      UTF-8 compact JSON of sorted [historical_path,classification,bytes.sha256] rows after
      complete import traversal. normalized_source_set_sha256 hashes those bytes.
  path_and_duplicate_algorithm:
    - Convert every registry path and resolved import to a repository-relative POSIX path.
    - Reject absolute paths, empty/dot/dot-dot segments, out-of-root realpaths, symlinks in any path segment, unreadable/non-regular files, and Unicode/case-fold collisions.
    - Resolve inheritance once in root-to-leaf order; explicit paths and recursive-root files form a set union. Repeated identical normalized membership is one entry, not an error.
    - Traverse statically resolvable TypeScript imports in lexical path order with a visited set. Tool-source membership has precedence; transitive_dependencies excludes every tool source.
    - Re-observe file identity and SHA after traversal. Same normalized path with different bytes or classification, or any mid-run drift, fails PRODUCER_RELEASE_MISMATCH.
    - Write each object exclusive-or-identical, then write the manifest exclusively. Existing different bytes/output fails; callers cannot override registry membership.
  command_contract: >
      validate-phase-progression --emit-producer-release accepts only canonical, case-set,
      object-root, and output. It resolves inheritance and sorted transitive TypeScript imports,
      applies path_and_duplicate_algorithm, freezes the normalized registry projection, writes
      content-addressed objects, and exclusively writes the exact manifest.
  independent_oracle: >
    Tests implement a second traversal that does not import the producer resolver. It compares
    exact sorted tool/dependency membership, classifications, object hashes, registry projection
    hash, and release ID. Isolated missing/import-cycle/symlink/case-collision/out-of-root/
    same-class duplicate/cross-class duplicate/mid-read mutation cases each assert one result.
  PHASE-01:
    inherit: null
    add_paths:
      - .agents/skills/plan-audit-archiver/scripts/validate-audit.ts
      - .agents/skills/plan-audit-archiver/scripts/capture-state.ts
      - .agents/skills/plan-audit-archiver/scripts/generate-evidence-receipt.ts
      - .agents/skills/plan-audit-archiver/scripts/prepare-audit.ts
      - .agents/skills/deterministic-implementation-planning/scripts/validate-plan.ts
      - .agents/skills/deterministic-implementation-planning/scripts/validate-phase-progression.ts
      - .agents/skills/plan-audit-archiver/scripts/__tests__/foundation-kernel.test.ts
