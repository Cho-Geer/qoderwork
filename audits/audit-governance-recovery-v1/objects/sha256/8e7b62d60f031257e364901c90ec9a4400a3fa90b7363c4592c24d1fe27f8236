dataflow_pipeline:
  description: >
    Formal phase-to-phase data contract. Each row declares the producer invocation, its
    input artifact (read-only at the start of the phase), its output artifact (write-once
    to the path the next phase consumes), and the consumer gate that the next phase
    enforces. The pipeline enforces the order: scope → entry → approval → pre-change →
    write → VERDICT → EV → report → progression → status. Replaces the informal "phase N
    depends on phase N-1" prose that previously left the producer/consumer contract
    implicit.
  rows:
    - phase: PHASE-01
      producer: validate-phase-progression.ts --create-scope-lock
      input: bootstrap/prewrite-verification.json
      output: bootstrap/scope-lock-PHASE-01-g001.json
      consumer_gate: PHASE-01 entry admission
    - phase: PHASE-01
      producer: capture-state.ts --upgrade-bootstrap-pre-change
      input: dual workspace HEAD
      output: phases/PHASE-01/g001/pre-change-state.json
      consumer_gate: PHASE-01 PRE_CHANGE
    - phase: PHASE-01
      producer: prepare-audit.ts --bootstrap-activate-and-close PHASE-01
      input: scope + pre-change + producer release
      output: phases/PHASE-01/g001/{auditor-findings.md, prepared/audit-report.md}
      consumer_gate: PHASE-01 audit gate
    - phase: PHASE-02
      producer: close-audit-phase.ts --adopt-closure-candidate PHASE-02
      input: PHASE-01 audit-report + producer release
      output: phases/PHASE-02/g001/closure-transaction/
      consumer_gate: PHASE-02 admission
    - phase: PHASE-02
      producer: validate-phase-progression.ts --create-scope-lock PHASE-02
      input: PHASE-01 closed-phase
      output: phases/PHASE-02/g001/scope-lock-PHASE-02-g001.json
      consumer_gate: PHASE-02 PRE_CHANGE
    - phase: PHASE-03
      producer: scripts/lib/artifact-reference-graph.ts (PHASE-03 allowed-step 3)
      input: artifact_dag registry
      output: buildArtifactGraph + validateEdges + kahnSort
      consumer_gate: PHASE-03 audit gate
    - phase: PHASE-04
      producer: scripts/check-audit-governance-recovery-conformance.ts (PHASE-04 allowed-step 1, CREATE)
      input: QUERY_REGISTRY + readSurface
      output: evaluateQuery + runConformance + CLI
      consumer_gate: PHASE-04 audit gate
    - phase: PHASE-05
      producer: prepare-audit.ts (consumes pre-audit-read-gate log)
      input: 5 mandatory validator files (per Pre-Audit Knowledge Required)
      output: SKILL.md + provenance-rules.md + AGENTS.md + 4 templates replaced
      consumer_gate: PHASE-05 audit gate
    - phase: PHASE-06
      producer: Auditor A writes implementation-evidence log
      input: PHASE-01..05 progression receipts
      output: logs/2026-07-30-audit-governance-recovery-implementation.md + documents/INDEX.md block + logs/INDEX.md entries
      consumer_gate: PHASE-06 audit gate
    - phase: 99-final
      producer: close-audit-phase.ts --final
      input: all 6 phase-accepted reports + producer release
      output: final/g001/{auditor-findings, prepared/audit-report, published/audit-report, verdict-state, pre-change-state}.json + progression-receipt
      consumer_gate: P4 M1 re-baseline gate
